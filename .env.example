# Groq LLM API Key (Required for live LLM reasoning, fallback used if empty)
GROQ_API_KEY=

# Hindsight Cloud API Key (Obtain from https://ui.hindsight.vectorize.io)
HINDSIGHT_API_KEY=

# Hindsight Server Base URL
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# Hindsight Organizational Memory Bank ID
HINDSIGHT_BANK_ID=novacart-production-memory

# LLM Model (e.g. qwen/qwen3-32b or llama-3.3-70b-versatile or qwen-2.5-32b)
LLM_MODEL=qwen-2.5-32b

# SQLite local database connection
DATABASE_URL=sqlite:///./backend/data/deploylens.db

# Demo Fallback Mode (Set to true to force deterministic demo mode)
DEMO_MODE=false
